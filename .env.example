# ─────────────────────────────────────────────────────────────────────────────
#  CardioCare — Environment Variables Template
#
#  HOW TO USE:
#    1. Copy this file:  cp .env.example .env
#    2. Fill in your real values
#    3. NEVER commit .env to Git
#
#  Generate JWT secret: python -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=cardiocare_db

# ── JWT Authentication ────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── ML ────────────────────────────────────────────────────────────────────────
MODEL_PATH=ml/saved_models/cardio_model.joblib
SCALER_PATH=ml/saved_models/cardio_scaler.joblib
MODEL_VERSION=v1.0
