# ─────────────────────────────────────────────────────────
#  CardioCare – Environment Variables Template
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to Git!
# ─────────────────────────────────────────────────────────

# ── MongoDB ───────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=cardiocare_db

# ── JWT Authentication ────────────────────────────────────
# Generate a secure random key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Application ───────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── ML Model ─────────────────────────────────────────────
MODEL_PATH=ml_models/cardio_model.joblib
SCALER_PATH=ml_models/cardio_scaler.joblib
